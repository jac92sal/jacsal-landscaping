# ─────────────────────────────────────────────────────────────
# Supabase connection (client-side / browser)
# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in YOUR OWN Supabase project values.
#   cp .env.example .env
#
# Find these in your Supabase dashboard:
#   Project Settings → API
#
# NOTE: The anon key is a PUBLIC key. It is safe to ship in the browser
# and is protected by Row Level Security (RLS) — NOT by being secret.
# Never put the service_role key here; it stays server-side only
# (Supabase Edge Function secrets / Deno.env), never in any .env that
# ships to the browser.

# Either set the full URL...
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# ...or just the project ref (URL is derived from it if VITE_SUPABASE_URL is unset)
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Public anon key (Project Settings → API → Project API keys → anon / public)
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
